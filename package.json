{
  "name": "cc-multi-cli-plugin",
  "version": "0.4.4",
  "private": true,
  "type": "module",
  "description": "Claude Code plugin providing a native model gateway that runs external models inside one Claude Code session.",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test:live:zen": "node test/live/native-zen.ts",
    "test:live:cursor": "node test/live/native-cursor-harness.ts",
    "test:live:codex": "node test/live/native-codex.ts",
    "test:live:antigravity": "node test/live/native-antigravity.ts",
    "test:live:grok": "node test/live/native-grok.ts",
    "test:live:front-door": "node test/live/native-front-door.ts",
    "test:live:desktop": "node test/live/native-desktop.ts",
    "format": "biome format --write .",
    "lint": "biome check --error-on-warnings .",
    "lint:fix": "biome check --write .",
    "check:unused": "knip",
    "check": "npm run banner:check && npm run check:versions && npm run check:providers && npm run lint && npm run check:unused && npm run typecheck",
    "banner:generate": "node scripts/banner.mjs",
    "banner:check": "node scripts/banner.mjs --check",
    "check:versions": "node scripts/check-versions.ts",
    "check:providers": "node scripts/check-providers.ts",
    "release": "node scripts/release.ts",
    "test:live:install": "node test/live/native-install.ts",
    "typecheck:mod": "tsc -p plugins/multi-core"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@types/node": "^26.4.1",
    "knip": "6.34.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@cursor/sdk": "1.0.31",
    "js-tiktoken": "1.0.21",
    "yaml": "2.9.0"
  }
}
