{
  "name": "cc-multi-cli-plugin",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "description": "Claude Code plugin providing a native model gateway that runs external models inside one Claude Code session.",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && node --test --test-timeout=120000 \"test/unit/**/*.test.ts\"",
    "test:mod": "node --input-type=module -e \"import { spawn } from 'node:child_process'; const child = spawn('claude', ['plugin', 'test', 'plugins/multi-core'], { stdio: 'inherit', env: { ...process.env, CLAUDE_CODE_ENABLE_FUNCTION_HOOKS: '1' } }); child.on('exit', (code) => { process.exitCode = code ?? 1; });\"",
    "test:live:compaction": "node test/live/native-compaction.ts",
    "test:live:zen": "node test/live/native-zen.ts",
    "test:live:cursor": "node test/live/native-cursor-harness.ts",
    "test:live:openai-instructions": "node test/live/native-openai-instructions.ts",
    "test:live:auto-mode": "node test/live/native-auto-mode.ts",
    "test:live:provider-approval": "node test/live/native-provider-approval.ts",
    "test:live:reviewer": "node test/live/native-reviewer.ts",
    "test:live:approval-worker": "node test/live/native-approval-worker.ts",
    "test:live:permissions": "node test/live/native-permissions.ts",
    "test:live:antigravity": "node test/live/native-antigravity.ts",
    "test:live:grok": "node test/live/native-grok.ts",
    "format": "biome format --write .",
    "lint": "biome check --error-on-warnings .",
    "lint:fix": "biome check --write .",
    "check:unused": "knip",
    "check": "npm run banner:check && npm run lint && npm run check:unused && npm test",
    "banner:generate": "node scripts/banner.mjs",
    "banner:check": "node scripts/banner.mjs --check",
    "test:live:install": "node test/live/native-install.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@types/node": "^26.4.1",
    "knip": "6.34.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@cursor/sdk": "1.0.31",
    "js-tiktoken": "1.0.21",
    "yaml": "2.9.0"
  }
}
